{
  "expo": {
    "name": "Campus Match",
    "slug": "campus-match",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "campusmatch",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "jp.campusmatch.app"
    },
    "android": {
      "package": "jp.campusmatch.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "プロフィール写真を設定するため、写真へのアクセスが必要です。",
          "cameraPermission": "プロフィール写真を撮影するため、カメラへのアクセスが必要です。"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
